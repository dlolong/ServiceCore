{
  "name": "servicecore",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run release:env -- --production",
    "start": "next start",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test e2e/release-smoke.spec.ts",
    "qa:seed": "node --env-file-if-exists=.env.local --import tsx scripts/qa-seed.ts",
    "release:env": "node --env-file-if-exists=.env.local --import tsx scripts/validate-environment.ts",
    "release:health": "node --import tsx scripts/check-health.ts",
    "release:check": "npm run release:env && npm test && npm run lint && npm run typecheck && npm run build",
    "maintenance:backfill": "tsx scripts/maintenance-backfill.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
